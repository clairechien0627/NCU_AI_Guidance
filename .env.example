# ── Azure OpenAI
# AZURE_OPENAI_ENDPOINT 填基底 URL（只含 scheme+host），不含路徑：
#   https://<your-resource>.openai.azure.com/
#   https://<your-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o                        # 對話模型的部署名稱
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large   # embedding 模型的部署名稱

# ── AI 供應商開關（對話／推理 LLM）
# azure（預設，未設定也是 azure）：所有對話模型走上面的 Azure OpenAI，行為與以前相同。
# bedrock：課程助理、單課問答、PDF 問答（router／chat／retrieval／research／側寫抽取）改用 Bedrock 上的 Claude。
# 不論設哪個，embedding 都維持 Azure text-embedding-3-large（3072 維），上面的 Azure 設定仍然必填。
AI_PROVIDER=azure

# ── Amazon Bedrock（僅 AI_PROVIDER=bedrock 時使用）
# 憑證走 boto3 預設鏈：AWS_ACCESS_KEY_ID／AWS_SECRET_ACCESS_KEY、AWS_PROFILE（含 SSO）、IAM role，
# 或 Bedrock API key（AWS_BEARER_TOKEN_BEDROCK）。不要把金鑰提交到版本控制。
# 模型 ID 以帳號在 Bedrock 開通的為準；global.* 是跨區域 inference profile。
# BEDROCK_REGION=ap-northeast-1                                        # 未設定時依序讀 AWS_REGION、AWS_DEFAULT_REGION，再預設 ap-northeast-1
# BEDROCK_CHAT_MODEL_ID=global.anthropic.claude-sonnet-4-6              # 主要對話模型（預設值）
# BEDROCK_MINI_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0 # 輕量模型：router、側寫抽取等（預設值）
# BEDROCK_MAX_TOKENS=8192                                              # 呼叫端沒指定時的輸出 token 上限

# ── LangSmith（LLM 監控，選填）
# 官網：https://smith.langchain.com/
# 不填則靜默略過，不影響系統運作
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=ncu-rag-system
LANGSMITH_TRACING=true

# -----------------------------------
# 應用程式設定（保留預設即可）
# -----------------------------------
APP_ENV=development
APP_PORT=8000
DATA_DIR=data
COURSE_JSON_PATH=data/processed/courses.json
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# -----------------------------------
# Cloudinary（上傳 PDF 用）
# -----------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PROJECT_FOLDER=ncu-ai-guidance/data/raw/projects

# PostgreSQL
DATABASE_URL=

# 開發人員 email（/monitor 監控頁面存取控制，多個用逗號分隔；不分大小寫）
# 也是 LIVE_AI_ACCESS=developers 時能使用即時 AI 的名單
DEVELOPER_EMAILS=

# 即時 AI（對話／推理型 LLM）開放對象
# all（預設，未設定也是 all）：所有人都能用課程助理、單課問答、PDF 問答，行為與以前相同。
# developers：只有 DEVELOPER_EMAILS 名單內、email 已驗證的登入帳號能用；其他人（含未登入）呼叫時回 403 LIVE_AI_RESTRICTED。
# 不燒對話 token 的功能（興趣量表、系所修課、課程資訊與語意搜尋、研究計畫瀏覽與 PDF）不受影響。
# 其他值（例如打錯字）會讓後端啟動失敗（LIVE_AI_ACCESS_INVALID），不會悄悄退回 all。
LIVE_AI_ACCESS=all

# Qdrant（向量資料庫）
# 本機開發可留空，會使用 data/processed/qdrant_data。
# 部署到雲端時填 Qdrant Cloud URL / API key。
QDRANT_URL=
QDRANT_API_KEY=

# Firebase Authentication
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# -----------------------------------
# PDF Chat（Multi-agent 問答）
# -----------------------------------
# Azure 模型部署名稱（PDF 問答使用；若與上方同名可留空由 pdf_config.py 讀取預設值）
AZURE_CHAT_DEPLOYMENT=gpt-4o
AZURE_MINI_DEPLOYMENT=gpt-4o-mini
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# LangSmith（PDF 問答獨立 project，與課程助理分開追蹤）
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=        # 同 LANGSMITH_API_KEY
LANGCHAIN_PROJECT=ncu-pdf-chat
