# /opt/ncu-backend/backend.env — 後端環境變數範例（複製成 backend.env 後填值，chmod 600）
# 真實的 backend.env 含金鑰：不要進 git、不要貼到任何地方。
#
# 格式（docker compose 的 env_file）：
#   - 一律寫成 KEY=value，值不要加引號（引號在不同工具間處理方式不一致，可能被當成值的一部分）
#   - 一個值只能一行，不支援多行值
#   - FIREBASE_SERVICE_ACCOUNT_JSON 要把整份 JSON 壓成一行（private_key 裡的換行保持 \n 跳脫）
# 改完執行 ./deploy.sh --env-only 讓容器重新讀取（docker restart 不會重讀）。

# ── 一般設定
ALLOWED_ORIGINS=https://frontend.example.com
LOG_LEVEL=INFO

# ── Azure OpenAI（預設的 AI 供應商；embedding 一律使用 text-embedding-3-large，3072 維）
# AZURE_OPENAI_ENDPOINT 只填基底 URL，例如 https://<resource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# 課程助理使用
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# PDF 問答使用（backend/app/pdf_config.py）
AZURE_CHAT_DEPLOYMENT=gpt-4o
AZURE_MINI_DEPLOYMENT=gpt-4o-mini
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ── Firebase 登入
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── 監控頁存取（逗號分隔 email，不分大小寫；也是 LIVE_AI_ACCESS=developers 時能用即時 AI 的名單）
DEVELOPER_EMAILS=

# ── 即時 AI（課程助理、單課問答、PDF 問答等會呼叫對話 LLM 的功能）開放對象
# all（預設，未設定也是 all）：所有人都能用。
# developers：只有 DEVELOPER_EMAILS 名單內、email 已驗證的登入帳號能用，其他人回 403；
#             正式站想先關閉即時 AI、只留給開發團隊時設成 developers。
# 其他值（打錯字）會讓後端啟動失敗（LIVE_AI_ACCESS_INVALID）。
# LIVE_AI_ACCESS=all

# ── PostgreSQL（對話紀錄、監控、PDF 問答 checkpointer）
DATABASE_URL=

# ── Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=
PDF_QDRANT_COLLECTION=reports

# ── 專題 PDF 連結（Cloudinary）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_PROJECT_FOLDER=ncu-ai-guidance/data/raw/projects
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── LangSmith（選填）
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
